    {
      "$type": "FormulaField",
      "FormulaText": "{Sales.Amount} - {Sales.Cost}",
      "Syntax": "",
      "ResultType": "Number",
      "Name": "Margin",
      "Kind": ""
    },
    {
      "$type": "FormulaField",
      "FormulaText": "if {Sales.Amount} <> 0 then\r\n    formula = {@Margin} / {Sales.Amount} * 100\r\nend if",
      "Syntax": "",
      "ResultType": "Number",
      "Name": "MarginPct",
      "Kind": ""
    },
    {
      "$type": "FormulaField",
      "FormulaText": "{Sales.Amount} / Sum({Sales.Amount}, {Sales.Region}) * 100",
      "Syntax": "",
      "ResultType": "Number",
      "Name": "Share",
      "Kind": ""
    },
    {
      "$type": "FormulaField",
      "FormulaText": "if {Sales.Amount} >= {?MinAmount} then \"*\" else \"\"",
      "Syntax": "",
      "ResultType": "String",
      "Name": "Flag",
      "Kind": ""
    },
    {
      "$type": "FormulaField",
      "FormulaText": "ProperCase({Sales.Rep}) & Chr(9) & {Sales.Notes}",
      "Syntax": "",
      "ResultType": "String",
      "Name": "Legacy",
      "Kind": ""
    },
    {
      "$type": "FormulaField",
      "FormulaText": "Round({Sales.Amount}, 2) +",
      "Syntax": "",
      "ResultType": "Number",
      "Name": "Broken",
      "Kind": ""
    },
